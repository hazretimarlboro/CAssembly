; ============================================================
;  Showcase program: recursion, iteration, and signed arithmetic
; ============================================================

; --- 1) factorial(6) via recursion (CALL/RET, manual stack spill) -----
MOV rax 6
CALL factorial
LOG rax                  ; expect rax: 720

; --- 2) gcd(48, 18) via iteration (Euclidean algorithm, MOD) -----------
MOV rax 48
MOV rbx 18
CALL gcd
LOG rax                  ; expect rax: 6

; --- 3) signed comparison check ----------------------------------------
MOV rax 1
MVN rax                  ; rax = -1
MOV rbx 5
CMP rax rbx
JL cmp_ok
MOV rcx 999               ; sentinel: bug present
LOG rcx
JMP cmp_after
cmp_ok:
MOV rcx 1                 ; sentinel: signed compare working
LOG rcx
cmp_after:

; --- 4) signed division check -------------------------------------------
MOV rdx 7
MVN rdx                   ; rdx = -7
DIV rdx 2
LOG rdx                   ; expect rdx: -3

HLT

; ------------------------- subroutines ----------------------------------

factorial:
    CMP rax 0
    JG fact_recurse
    MOV rax 1
    RET
fact_recurse:
    PUSH rax
    ADD rax -1
    CALL factorial
    POP rbx
    MUL rax rbx
    RET

gcd:
    CMP rbx 0
    JEQ gcd_end
    MOV rcx rax
    MOD rcx rbx
    MOV rax rbx
    MOV rbx rcx
    JMP gcd
gcd_end:
    RET